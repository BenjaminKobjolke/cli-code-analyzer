{
  "log_level": "all",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": ["venv/**", "__pycache__/**", "*.pyc", ".git/**"],
    "exceptions": [
      {"file": "example/**", "warning": 500, "error": 600}
    ]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "python": ["venv/**", "__pycache__/**", "*.pyc", ".git/**"]
    }
  },
  "ruff_analyze": {
    "enabled": true,
    "select": [
      "F",
      "E4", "E7", "E9",
      "W",
      "I",
      "B",
      "UP",
      "SIM",
      "C4",
      "PIE",
      "ARG",
      "RUF"
    ],
    "ignore": [],
    "exclude_patterns": ["venv", "__pycache__", ".git", ".venv", "node_modules", "build", "dist", "example"]
  },
  "phpstan_analyze": {
    "enabled": false,
    "level": 5,
    "exclude_patterns": ["vendor/**", "node_modules/**", ".git/**"]
  },
  "php_cs_fixer": {
    "enabled": false,
    "rules": "@PSR12",
    "exclude_patterns": ["vendor/**", "node_modules/**", ".git/**"]
  },
  "intelephense_analyze": {
    "enabled": false,
    "min_severity": "warning",
    "timeout": 5,
    "exclude_patterns": ["vendor/**", "node_modules/**", ".git/**"],
    "ignore_unused_underscore": true
  },
  "graphify_fanout": {
    "enabled": false,
    "info": 15,
    "warning": 20,
    "error": 32,
    "ratio_max": 0.25,
    "graph_path": "graphify-out/graph.json",
    "hub_classes": [],
    "hub_autodetect": true,
    "hub_min_fanin": 25,
    "hub_autodetect_percentile": 99,
    "auto_build": false,
    "build_path": "src",
    "exceptions": []
  },
  "semgrep_analyze": {
    "enabled": true,
    "config": null,
    "exclude_patterns": ["venv", ".venv", "__pycache__", ".git", "example"]
  }
}
